generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  name         String
  passwordHash String
  role         UserRole
  studentId    String?  @unique
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id                String       @id @default(uuid())
  name              String
  className         String
  attendanceNumber  Int
  nis               String       @unique
  nisn              String       @unique
  phone             String?
  address           String?
  photo             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User?
  attendances       Attendance[]
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         // Tanggal absensi harian
  status    AttendanceStatus @default(HADIR) // Default status adalah Hadir
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date]) // Mencegah duplikasi data absensi ganda untuk siswa di tanggal yang sama
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
}

enum UserRole {
  SEKRETARIS
  KETUA_KELAS
  SISWA
}